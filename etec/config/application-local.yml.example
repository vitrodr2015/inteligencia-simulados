# Copie este arquivo para config/application-local.yml (ignorado pelo Git),
# troque os valores e rode com SPRING_PROFILES_ACTIVE=local.
# Os valores abaixo são falsos de propósito; nunca coloque segredo real neste .example.
DB_PASSWORD: troque-a-senha-do-banco
JWT_SECRET: troque-este-segredo-por-um-com-no-minimo-32-caracteres
ADMIN_SENHA: troque-a-senha-do-admin
# Termos de uso vigentes (D23, D94); sem padrão no application.yml. Valores de exemplo.
TERMOS_VERSAO: v1
TERMOS_URL: https://exemplo.invalid/termos
